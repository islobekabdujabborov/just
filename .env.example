# React/Vite: leave empty for same-origin production API, or use local Django API in development
VITE_API_URL=/api

# Telegram verification bot config is stored on the backend service, not in the frontend.
# Configure the same values in Railway as backend environment variables.
# TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
# TELEGRAM_BOT_USERNAME=Abitbook_bot
# TELEGRAM_VERIFICATION_CODE_TTL=300
# TELEGRAM_VERIFICATION_MAX_ATTEMPTS=5
# TELEGRAM_VERIFICATION_RESEND_COOLDOWN=60
# TELEGRAM_VERIFICATION_MAX_RESENDS=3
# TELEGRAM_VERIFICATION_SESSION_TTL=900
